# ===========================
# AgriVisionAI Environment Variables
# ===========================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Frontend & Backend Production URLs ---
NEXT_PUBLIC_API_URL=https://YOUR-DEPLOYED-BACKEND-URL
FRONTEND_URL=https://verdrax.vercel.app

# --- Weather API ---
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# --- Model ---
MODEL_PATH=models/agri_vision_model.keras
CLASS_NAMES_PATH=models/class_names.json

# --- App ---
APP_ENV=production
CORS_ORIGINS=https://verdrax.vercel.app

# --- Optional: LLM for AI Assistant ---
# OPENAI_API_KEY=your-openai-api-key
# LLM_PROVIDER=openai
